{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "state": {
      "type": "string",
      "minLength": 1
    },
    "county": {
      "type": "string",
      "minLength": 1
    },
    "output": {
      "default": "./runs",
      "type": "string"
    },
    "sources": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approaches": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "api",
          "browser",
          "download"
        ]
      }
    },
    "seedUrls": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "maxTargets": {
      "default": 40,
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "attachments": {
      "default": "all",
      "type": "string",
      "enum": [
        "all",
        "none"
      ]
    },
    "jsonArray": {
      "default": false,
      "type": "boolean"
    },
    "headful": {
      "default": false,
      "type": "boolean"
    },
    "interactiveAuth": {
      "default": false,
      "type": "boolean"
    },
    "credentialProfile": {
      "type": "string"
    },
    "maxDuration": {
      "default": 7200,
      "type": "number",
      "exclusiveMinimum": 0
    },
    "maxBytes": {
      "default": 5368709120,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "minFreeBytes": {
      "default": 104857600,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "maxRecords": {
      "default": 1000000,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "intervalMs": {
      "default": 1000,
      "type": "integer",
      "minimum": 1000,
      "maximum": 9007199254740991
    },
    "batchSize": {
      "default": 500,
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "logLevel": {
      "default": "info",
      "type": "string",
      "enum": [
        "info",
        "error",
        "debug"
      ]
    }
  },
  "required": [
    "state",
    "county",
    "output",
    "sources",
    "approaches",
    "seedUrls",
    "maxTargets",
    "attachments",
    "jsonArray",
    "headful",
    "interactiveAuth",
    "maxDuration",
    "maxBytes",
    "minFreeBytes",
    "maxRecords",
    "intervalMs",
    "batchSize",
    "logLevel"
  ],
  "additionalProperties": false
}
